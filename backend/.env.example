# YouTube accounts. Each account has its own Google OAuth client and its own sign-in.
# Add an account by adding its key to YOUTUBE_ACCOUNTS and the three lines below (key in capitals).
YOUTUBE_ACCOUNTS=first,second
YOUTUBE_FIRST_LABEL=first@gmail.com
YOUTUBE_FIRST_CLIENT_ID=
YOUTUBE_FIRST_CLIENT_SECRET=
YOUTUBE_SECOND_LABEL=second@gmail.com
YOUTUBE_SECOND_CLIENT_ID=
YOUTUBE_SECOND_CLIENT_SECRET=
